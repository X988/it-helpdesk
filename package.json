{
  "name": "it-helpdesk",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "check": "prisma validate && npm run typecheck && npm run lint && npm test",
    "db:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
    "notifications:deliver": "node --env-file-if-exists=.env --import tsx scripts/deliver-notifications.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "@typescript-eslint/parser": "8.71.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
