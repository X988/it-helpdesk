generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { USER TECHNICIAN ADMIN }
enum TicketStatus { NEW IN_PROGRESS WAITING_FOR_USER RESOLVED CLOSED CANCELLED }
enum Priority { LOW NORMAL HIGH URGENT }
enum MessageVisibility { PUBLIC INTERNAL }
enum NotificationType { TICKET_CREATED TICKET_ASSIGNED STATUS_CHANGED NEW_MESSAGE WAITING_FOR_USER TICKET_RESOLVED TICKET_REOPENED TICKET_CLOSED }

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  organization String?
  department   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tickets      Ticket[] @relation("TicketRequester")
  assigned     Ticket[] @relation("TicketAssignee")
  messages     TicketMessage[]
  attachments  TicketAttachment[]
  telegram     TelegramConnection?
  notifications Notification[]
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model Ticket {
  id          String       @id @default(uuid()) @db.Uuid
  number      Int          @unique @default(autoincrement())
  subject     String
  description String
  priority    Priority     @default(NORMAL)
  status      TicketStatus @default(NEW)
  requesterId String       @db.Uuid
  assigneeId  String?      @db.Uuid
  categoryId  String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  requester   User         @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee    User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  messages    TicketMessage[]
  attachments TicketAttachment[]
  assignments TicketAssignment[]
  statusHistory TicketStatusHistory[]
  notifications Notification[]
  @@index([status, createdAt])
  @@index([requesterId, createdAt])
  @@index([assigneeId, status])
  @@index([categoryId])
}

model TicketMessage {
  id         String            @id @default(uuid()) @db.Uuid
  ticketId   String            @db.Uuid
  authorId   String            @db.Uuid
  body       String
  visibility MessageVisibility @default(PUBLIC)
  createdAt  DateTime          @default(now())
  ticket     Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  uploaderId   String   @db.Uuid
  originalName String
  objectKey    String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  @@index([ticketId])
}

model TicketAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  ticketId       String   @db.Uuid
  fromAssigneeId String?  @db.Uuid
  toAssigneeId   String?  @db.Uuid
  actorId        String   @db.Uuid
  createdAt      DateTime @default(now())
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model TicketStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  ticketId   String       @db.Uuid
  fromStatus TicketStatus?
  toStatus   TicketStatus
  actorId    String       @db.Uuid
  createdAt  DateTime     @default(now())
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  ticketId  String?          @db.Uuid
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model TelegramConnection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  chatId      String   @unique
  linkedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLinkToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
