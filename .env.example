DATABASE_URL=postgresql://helpdesk:change_me@127.0.0.1:5432/helpdesk
APP_URL=http://localhost:3000
PORT=3000
# Production uses HTTPS. Set true only for an explicit local production smoke test.
ALLOW_INSECURE_HTTP=false
# Used by compose.yml; use a random hexadecimal password to avoid URL escaping.
POSTGRES_PASSWORD=
# Optional integrations: set every variable in each group, or none.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CRON_SECRET=
# Set only for the first administrator, then remove.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Development only.
SEED_PASSWORD=
# Tests only; must be a separate database whose name ends in _test.
TEST_DATABASE_URL=
