DATABASE_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Storage: leave S3 empty to use local disk fallback
STORAGE_BACKEND=
# local | s3  (auto: s3 if all S3_* set, else local)
LOCAL_STORAGE_PATH=
# default: ./data/uploads

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Development seed only (12+ chars). Never use in production.
SEED_PASSWORD=

# Active Directory / LDAP (optional). When unset, local seed accounts work via energo\admin etc.
LDAP_URL=
# Example: ldap://dc01.energo.local:389  or  ldaps://dc01.energo.local:636
LDAP_BASE_DN=
# Example: DC=energo,DC=local
LDAP_DOMAIN=energo
LDAP_DOMAINS=energo
# Comma-separated list for login dropdown; defaults to LDAP_DOMAIN
LDAP_UPN_SUFFIX=
# Example: energo.local  → bind as user@energo.local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Optional service account for reading department/company if user-bind cannot search
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_EMAIL_DOMAIN=energo.local
# Set to false only for lab DCs with self-signed LDAPS certs
LDAP_TLS_REJECT_UNAUTHORIZED=true

# Optional extra support contacts shown to users: Name|phone|email;Name2|...
SUPPORT_CONTACTS=
