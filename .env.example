DATABASE_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Storage: leave S3 empty to use local disk fallback
STORAGE_BACKEND=
# local | s3  (auto: s3 if all S3_* set, else local)
LOCAL_STORAGE_PATH=
# default: ./data/uploads

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Development seed only (12+ chars). Never use in production.
SEED_PASSWORD=

# Active Directory / LDAP (optional). When unset, local seed accounts work via energo\admin etc.
LDAP_URL=
# Example: ldap://dc01.energo.local:389  or  ldaps://dc01.energo.local:636
LDAP_BASE_DN=
# Example: DC=energo,DC=local
LDAP_DOMAIN=
LDAP_DOMAINS=
# Короткое имя домена этого предприятия (DOMAIN\user). Пусто — поле на входе пустое.
LDAP_UPN_SUFFIX=
# Example: energo.local  → bind as user@energo.local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Optional service account for directory sync + profile search.
# Example DN: CN=helpdesk-sync,OU=Service Accounts,OU=DTE,DC=energo,DC=local
# Or UPN: helpdesk-sync@energo.local
# If empty, admin can sync once by entering their own AD password in the UI.
LDAP_OU_ROOT=
# Optional: limit sync to a subtree, e.g. OU=DTE,DC=energo,DC=local
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_EMAIL_DOMAIN=energo.local
# Set to false only for lab DCs with self-signed LDAPS certs
LDAP_TLS_REJECT_UNAUTHORIZED=true

# Scheduler. Internal timer runs inside `next start` unless DISABLE_INTERNAL_SCHEDULER=true.
# External cron: POST /api/internal/jobs with header x-cron-secret.
CRON_SECRET=
DISABLE_INTERNAL_SCHEDULER=

# SMTP. When SMTP_HOST is empty, mail is logged and ticket operations still succeed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional extra support contacts shown to users: Name|phone|email;Name2|...
SUPPORT_CONTACTS=


